<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Import it to use one version of every Task 2.0 module. No parent: a BOM manages versions and nothing else. -->
  <groupId>org.example.task2</groupId>
  <artifactId>task2-bom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <description>Task 2.0 bill of materials: import it, then add the modules without versions.</description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.example.task2</groupId>
        <artifactId>task2-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.example.task2</groupId>
        <artifactId>task2-spi</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.example.task2</groupId>
        <artifactId>task2-engine</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.example.task2</groupId>
        <artifactId>task2-postgres</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.example.task2</groupId>
        <artifactId>task2-memory</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.example.task2</groupId>
        <artifactId>task2-micrometer</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.example.task2</groupId>
        <artifactId>task2-jackson</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.example.task2</groupId>
        <artifactId>task2-junit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.example.task2</groupId>
        <artifactId>task2-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
