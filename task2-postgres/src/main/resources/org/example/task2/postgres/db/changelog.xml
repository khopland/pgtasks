<?xml version="1.0" encoding="UTF-8"?>
<!--
  Liquibase wrapper for the tasks schema: the same plain SQL files the built-in runner applies.
  Include it from your own changelog and run the library with schema mode VALIDATE:

    <include file="org/example/task2/postgres/db/changelog.xml"/>

  Works with Liquibase 4 and 5 and adds no dependency to the library. Versioned files run once;
  repeatable files run again when they change (runOnChange). A file whose header carries the
  task:no-transaction marker gets runInTransaction="false". Each file is sent whole, unsplit, the
  way psql runs it, because the repeatable files use dollar quoting.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="tasks-V001" author="task2">
        <sqlFile path="V001__tasks_schema.sql" relativeToChangelogFile="true" splitStatements="false"/>
    </changeSet>

    <changeSet id="tasks-R__create_topic" author="task2" runOnChange="true">
        <sqlFile path="R__create_topic.sql" relativeToChangelogFile="true" splitStatements="false"/>
    </changeSet>

    <changeSet id="tasks-R__notify_limit" author="task2" runOnChange="true">
        <sqlFile path="R__notify_limit.sql" relativeToChangelogFile="true" splitStatements="false"/>
    </changeSet>

    <changeSet id="tasks-R__notify_ready" author="task2" runOnChange="true">
        <sqlFile path="R__notify_ready.sql" relativeToChangelogFile="true" splitStatements="false"/>
    </changeSet>

    <changeSet id="tasks-R__task_view" author="task2" runOnChange="true">
        <sqlFile path="R__task_view.sql" relativeToChangelogFile="true" splitStatements="false"/>
    </changeSet>
</databaseChangeLog>
