  <build>
    <pluginManagement>
      <plugins>
        <!-- Pinned, so the build doesn't change with the Maven version that runs it. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.7.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <!-- The Postgres driver and Micrometer have no module descriptors. The modules that need them can only require their automatic names, and Micrometer's types are part of their public API. -->
            <compilerArgs>
              <arg>-Xlint:all,-serial,-processing,-try,-requires-automatic,-requires-transitive-automatic</arg>
              <arg>-parameters</arg>
            </compilerArgs>
            <!-- A module adding its own processors appends with combine.children="append". -->
            <annotationProcessorPaths>
              <path>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_core</artifactId>
                <version>${errorprone.version}</version>
              </path>
              <path>
                <groupId>com.uber.nullaway</groupId>
                <artifactId>nullaway</artifactId>
                <version>${nullaway.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
          <executions>
            <!--
              Main code only: Javadoc is checked (broken links, bad HTML and misused tags fail it), and
              Error Prone runs with NullAway, which checks every @NullMarked package against its
              @Nullable annotations. Warnings fail the build.
            -->
            <execution>
              <id>default-compile</id>
              <configuration>
                <compilerArgs combine.children="append">
                  <arg>-Xdoclint:all,-missing</arg>
                  <arg>-Werror</arg>
                  <arg>-XDcompilePolicy=simple</arg>
                  <arg>--should-stop=ifError=FLOW</arg>
                  <arg>-Xplugin:ErrorProne -Xep:MissingSummary:OFF -Xep:RemoveUnusedImports:ERROR -Xep:NullAway:ERROR -XepOpt:NullAway:OnlyNullMarked=true -XepOpt:NullAway:JSpecifyMode=true</arg>
                </compilerArgs>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
          <configuration>
            <archive>
              <manifestEntries>
                <!-- A stable module name for applications on the module path; each module sets module.name. -->
                <Automatic-Module-Name>${module.name}</Automatic-Module-Name>
              </manifestEntries>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.12.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>3.2.8</version>
        </plugin>
        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>0.12.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
          <configuration>
            <!--
              Tests compile as patches to their module, so javac enforces the boundaries, but run on the
              classpath: test-jar fixtures and test-only dependencies aren't part of the module descriptors.
            -->
            <useModulePath>false</useModulePath>
            <trimStackTrace>false</trimStackTrace>
            <systemPropertyVariables>
              <org.slf4j.simpleLogger.defaultLogLevel>warn</org.slf4j.simpleLogger.defaultLogLevel>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.16</version>
        </plugin>
        <plugin>
          <groupId>com.github.siom79.japicmp</groupId>
          <artifactId>japicmp-maven-plugin</artifactId>
          <version>0.27.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Error Prone needs the javac exports in .mvn/jvm.config, which need JDK 25 and Maven 3.9. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-tools</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- See pgtasks.api.baseline. -->
      <plugin>
        <groupId>com.github.siom79.japicmp</groupId>
        <artifactId>japicmp-maven-plugin</artifactId>
        <configuration>
          <oldVersion>
            <dependency>
              <groupId>${project.groupId}</groupId>
              <artifactId>${project.artifactId}</artifactId>
              <version>${pgtasks.api.baseline}</version>
              <type>jar</type>
            </dependency>
          </oldVersion>
          <parameter>
            <accessModifier>protected</accessModifier>
            <onlyModified>true</onlyModified>
            <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
            <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
            <!-- A module that didn't exist at the baseline has nothing to be compatible with. -->
            <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
            <ignoreNonResolvableArtifacts>false</ignoreNonResolvableArtifacts>
            <skipPomModules>true</skipPomModules>
            <!--
              Accepted breaks since the baseline, cleared with each release: a class
              (<exclude>io.github.khopland.pgtasks.Foo</exclude>) or a member
              (<exclude>io.github.khopland.pgtasks.Foo#bar(java.lang.String)</exclude>).
            -->
            <excludes>
              <!-- 0.2.0: stores take unfinished tasks out of the queue for admin().cancel(...). -->
              <exclude>io.github.khopland.pgtasks.spi.TaskStore#cancel(io.github.khopland.pgtasks.spi.StoreTransaction,int,io.github.khopland.pgtasks.admin.TaskQuery,int)</exclude>
              <!-- 0.2.0: state extensions keep in memory per store. -->
              <exclude>io.github.khopland.pgtasks.spi.TaskStore#shared(java.lang.Class,java.util.function.Supplier)</exclude>
              <!--
                0.2.0: the extension API grows what extensions need. Methods added to ExtensionContext
                need no exclude (japicmp-engine-implemented.groovy); these change or remove one.
              -->
              <exclude>io.github.khopland.pgtasks.engine.extension.ExtensionContext#leading()</exclude>
              <exclude>io.github.khopland.pgtasks.engine.extension.ExtensionContext#job(io.github.khopland.pgtasks.engine.extension.HousekeepingJob)</exclude>
              <exclude>io.github.khopland.pgtasks.engine.extension.ExtensionContext#channel(java.lang.String,java.lang.Runnable)</exclude>
              <exclude>io.github.khopland.pgtasks.engine.extension.ExtensionContext#onStart(java.lang.Runnable)</exclude>
              <exclude>io.github.khopland.pgtasks.engine.extension.ExtensionContext#onStop(java.lang.Runnable)</exclude>
              <!-- 0.2.0: a gate implements permit(topic, wanted) and is told the claimed task ids. -->
              <exclude>io.github.khopland.pgtasks.engine.extension.ClaimGate#permit(io.github.khopland.pgtasks.TopicRef)</exclude>
              <exclude>io.github.khopland.pgtasks.engine.extension.ClaimGate#permit(io.github.khopland.pgtasks.TopicRef,int)</exclude>
              <exclude>io.github.khopland.pgtasks.engine.extension.ClaimGate#claimed(io.github.khopland.pgtasks.TopicRef,int)</exclude>
              <!--
                0.2.0: records that grow became final classes, so they can grow without breaking
                again: the same accessors, made with factories, a public constructor kept where
                there was one.
              -->
              <exclude>io.github.khopland.pgtasks.engine.extension.ClaimGate$Permit</exclude>
              <exclude>io.github.khopland.pgtasks.engine.extension.BatchListener$Completed</exclude>
              <exclude>io.github.khopland.pgtasks.engine.extension.SettingKey</exclude>
              <exclude>io.github.khopland.pgtasks.engine.EngineHealth</exclude>
              <!-- 0.2.0: pgtasks.extensions.* and the endpoint's extension actions. -->
              <exclude>io.github.khopland.pgtasks.spring.TaskProperties#TaskProperties(boolean,io.github.khopland.pgtasks.spring.TaskProperties$Store,io.github.khopland.pgtasks.SchemaMode,java.lang.String,java.lang.String,java.time.Duration,java.time.Duration,boolean,java.time.Duration,java.util.Map,boolean,java.lang.String,java.util.List)</exclude>
              <exclude>io.github.khopland.pgtasks.spring.TaskEndpoint#act(java.lang.String,java.lang.String,java.lang.String,java.lang.String,java.lang.String,java.lang.String,java.lang.String,java.lang.String,java.lang.String,java.lang.String,java.lang.String)</exclude>
            </excludes>
            <!-- Methods added to interfaces only the engine implements aren't breaks; see the script. -->
            <postAnalysisScript>${maven.multiModuleProjectDirectory}/pgtasks-parent/japicmp-engine-implemented.groovy</postAnalysisScript>
          </parameter>
        </configuration>
        <dependencies>
          <!-- Runs the post-analysis script. -->
          <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy-jsr223</artifactId>
            <version>5.0.8</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>api-compatibility</id>
            <phase>verify</phase>
            <goals>
              <goal>cmp</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!--
    The Postgres major version the tests run on: -Dpgtasks.test.postgres.version=18 picks the
    embedded binaries, and TestPostgres checks that the server it reaches has that version, also
    when it is an external one. Without the property, tests run on the default above.
  -->
  <profiles>
    <!--
      Publishing to Maven Central: sources and Javadoc jars, GPG signatures, and the Central
      Portal bundle. Used by .github/workflows/release.yml; see RELEASING.md. The BOM, which has
      no parent, repeats this profile.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>enforce-release</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireReleaseVersion>
                      <message>Set a release version first (the release workflow takes it from the tag).</message>
                    </requireReleaseVersion>
                    <requireReleaseDeps>
                      <message>A release can't depend on snapshots.</message>
                    </requireReleaseDeps>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <configuration>
              <quiet>true</quiet>
              <doclint>all,-missing</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <!-- The passphrase comes from MAVEN_GPG_PASSPHRASE; loopback lets gpg take it without a terminal. -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!--
                Publishes as soon as Central validates the bundle, and waits for that: publishing the
                draft GitHub release is the approval (RELEASING.md). A bundle that fails validation is
                never published.
              -->
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
              <waitMaxTime>3600</waitMaxTime>
              <skipPublishing>${central.skipPublishing}</skipPublishing>
              <excludeArtifacts>
                <artifact>pgtasks-benchmark</artifact>
                <artifact>pgtasks-coverage</artifact>
              </excludeArtifacts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!--
      Test coverage with JaCoCo: each module's tests run with the agent, and pgtasks-coverage
      merges them into one report in pgtasks-coverage/target/site/jacoco-aggregate. CI's
      coverage job runs with it. Off by default, so local runs and the Fray and benchmark JVMs
      don't carry the agent.
    -->
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>postgres-17</id>
      <activation>
        <property>
          <name>pgtasks.test.postgres.version</name>
          <value>17</value>
        </property>
      </activation>
      <properties>
        <embedded-postgres-binaries.version>17.12.0</embedded-postgres-binaries.version>
      </properties>
    </profile>
    <profile>
      <id>postgres-18</id>
      <activation>
        <property>
          <name>pgtasks.test.postgres.version</name>
          <value>18</value>
        </property>
      </activation>
      <properties>
        <embedded-postgres-binaries.version>18.7.0</embedded-postgres-binaries.version>
      </properties>
