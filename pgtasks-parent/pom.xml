      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-recurring</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
