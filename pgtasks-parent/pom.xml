<?xml version="1.0" encoding="UTF-8"?>
<project child.project.url.inherit.append.path="false" xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.khopland.pgtasks</groupId>
  <artifactId>pgtasks-parent</artifactId>
  <name>pgtasks parent</name>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <description>A task queue in the Postgres database you already run.</description>
  <url>https://github.com/khopland/pgtasks</url>
  <inceptionYear>2020</inceptionYear>
  <!-- Maven Central requires name, description, url, licenses, developers and scm in every published pom. -->
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>khopland</id>
      <name>Kristoffer Larsen Hopland</name>
      <url>https://github.com/khopland</url>
    </developer>
  </developers>
  <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/khopland/pgtasks.git</connection>
    <developerConnection>scm:git:git@github.com:khopland/pgtasks.git</developerConnection>
    <url>https://github.com/khopland/pgtasks</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/khopland/pgtasks/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <postgresql.version>42.7.15</postgresql.version>
    <hikari.version>7.1.0</hikari.version>
    <!-- Test scope only: pgtasks depends on no migration tool. For the 1.x schema and the parity test. -->
    <liquibase.version>5.0.4</liquibase.version>
    <flyway.version>13.13.0</flyway.version>
    <embedded-postgres.version>2.2.3</embedded-postgres.version>
    <!-- The default Postgres for tests; CI also runs the profiles below. See README, Requirements. -->
    <embedded-postgres-binaries.version>17.12.0</embedded-postgres-binaries.version>
    <slf4j.version>2.0.20</slf4j.version>
    <micrometer.version>1.18.0</micrometer.version>
    <jspecify.version>1.0.1</jspecify.version>
    <jackson.version>3.3.0</jackson.version>
    <micrometer-tracing.version>1.8.0</micrometer-tracing.version>
    <!-- Compile-time checks on main code; javac needs the exports in .mvn/jvm.config. -->
    <errorprone.version>2.53.0</errorprone.version>
    <nullaway.version>0.14.4</nullaway.version>
    <!-- Release profile: true builds the Central bundle without uploading it, to check it locally. -->
    <central.skipPublishing>false</central.skipPublishing>
    <!--
      API compatibility (japicmp): every jar is compared with the same artifact at this released
      version, and any binary or source incompatible change fails the build. Empty until 0.1.0 is
      on Maven Central; after each release, RELEASING.md sets it to that version and clears the
      accepted breaks in the japicmp plugin below. A break made on purpose is added there as an
      exclude, with a line in CHANGELOG.md, so it is a decision and not an accident.
    -->
    <pgtasks.api.baseline></pgtasks.api.baseline>
    <japicmp.skip>true</japicmp.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.jspecify</groupId>
        <artifactId>jspecify</artifactId>
        <version>${jspecify.version}</version>
      </dependency>
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.zonky.test.postgres</groupId>
        <artifactId>embedded-postgres-binaries-bom</artifactId>
        <version>${embedded-postgres-binaries.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-spi</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-engine</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-postgres</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-memory</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-test</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-rate-limit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-rate-limit-postgres</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-micrometer</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-jackson</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-junit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-bom</artifactId>
        <version>${micrometer.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-tracing-bom</artifactId>
        <version>${micrometer-tracing.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>com.zaxxer</groupId>
        <artifactId>HikariCP</artifactId>
        <version>${hikari.version}</version>
      </dependency>
      <dependency>
        <groupId>org.liquibase</groupId>
        <artifactId>liquibase-core</artifactId>
        <version>${liquibase.version}</version>
      </dependency>
      <dependency>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-core</artifactId>
        <version>${flyway.version}</version>
      </dependency>
      <dependency>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-database-postgresql</artifactId>
        <version>${flyway.version}</version>
      </dependency>
      <dependency>
        <groupId>io.zonky.test</groupId>
        <artifactId>embedded-postgres</artifactId>
        <version>${embedded-postgres.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-simple</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Pinned, so the build doesn't change with the Maven version that runs it. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.7.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <!-- The Postgres driver and Micrometer have no module descriptors. The modules that need them can only require their automatic names, and Micrometer's types are part of their public API. -->
            <compilerArgs>
              <arg>-Xlint:all,-serial,-processing,-try,-requires-automatic,-requires-transitive-automatic</arg>
              <arg>-parameters</arg>
            </compilerArgs>
            <!-- A module adding its own processors appends with combine.children="append". -->
            <annotationProcessorPaths>
              <path>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_core</artifactId>
                <version>${errorprone.version}</version>
              </path>
              <path>
                <groupId>com.uber.nullaway</groupId>
                <artifactId>nullaway</artifactId>
                <version>${nullaway.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
          <executions>
            <!--
              Main code only: Javadoc is checked (broken links, bad HTML and misused tags fail it), and
              Error Prone runs with NullAway, which checks every @NullMarked package against its
              @Nullable annotations. Warnings fail the build.
            -->
            <execution>
              <id>default-compile</id>
              <configuration>
                <compilerArgs combine.children="append">
                  <arg>-Xdoclint:all,-missing</arg>
                  <arg>-Werror</arg>
                  <arg>-XDcompilePolicy=simple</arg>
                  <arg>--should-stop=ifError=FLOW</arg>
                  <arg>-Xplugin:ErrorProne -Xep:MissingSummary:OFF -Xep:RemoveUnusedImports:ERROR -Xep:NullAway:ERROR -XepOpt:NullAway:OnlyNullMarked=true -XepOpt:NullAway:JSpecifyMode=true</arg>
                </compilerArgs>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
          <configuration>
            <archive>
              <manifestEntries>
                <!-- A stable module name for applications on the module path; each module sets module.name. -->
                <Automatic-Module-Name>${module.name}</Automatic-Module-Name>
              </manifestEntries>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.12.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>3.2.8</version>
        </plugin>
        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>0.12.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
          <configuration>
            <!--
              Tests compile as patches to their module, so javac enforces the boundaries, but run on the
              classpath: test-jar fixtures and test-only dependencies aren't part of the module descriptors.
            -->
            <useModulePath>false</useModulePath>
            <trimStackTrace>false</trimStackTrace>
            <systemPropertyVariables>
              <org.slf4j.simpleLogger.defaultLogLevel>warn</org.slf4j.simpleLogger.defaultLogLevel>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.16</version>
        </plugin>
        <plugin>
          <groupId>com.github.siom79.japicmp</groupId>
          <artifactId>japicmp-maven-plugin</artifactId>
          <version>0.27.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Error Prone needs the javac exports in .mvn/jvm.config, which need JDK 25 and Maven 3.9. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-tools</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- See pgtasks.api.baseline: skipped until there is a release to compare with. -->
      <plugin>
        <groupId>com.github.siom79.japicmp</groupId>
        <artifactId>japicmp-maven-plugin</artifactId>
        <configuration>
          <oldVersion>
            <dependency>
              <groupId>${project.groupId}</groupId>
              <artifactId>${project.artifactId}</artifactId>
              <version>${pgtasks.api.baseline}</version>
              <type>jar</type>
            </dependency>
          </oldVersion>
          <parameter>
            <accessModifier>protected</accessModifier>
            <onlyModified>true</onlyModified>
            <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
            <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
            <!-- A module that didn't exist at the baseline has nothing to be compatible with. -->
            <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
            <ignoreNonResolvableArtifacts>false</ignoreNonResolvableArtifacts>
            <skipPomModules>true</skipPomModules>
            <!--
              Accepted breaks since the baseline, cleared with each release: a class
              (<exclude>io.github.khopland.pgtasks.Foo</exclude>) or a member
              (<exclude>io.github.khopland.pgtasks.Foo#bar(java.lang.String)</exclude>).
            -->
            <excludes>
            </excludes>
          </parameter>
        </configuration>
        <executions>
          <execution>
            <id>api-compatibility</id>
            <phase>verify</phase>
            <goals>
              <goal>cmp</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!--
    The Postgres major version the tests run on: -Dpgtasks.test.postgres.version=18 picks the
    embedded binaries, and TestPostgres checks that the server it reaches has that version, also
    when it is an external one. Without the property, tests run on the default above.
  -->
  <profiles>
    <!--
      Publishing to Maven Central: sources and Javadoc jars, GPG signatures, and the Central
      Portal bundle. Used by .github/workflows/release.yml; see RELEASING.md. The BOM, which has
      no parent, repeats this profile.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>enforce-release</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireReleaseVersion>
                      <message>Set a release version first (the release workflow takes it from the tag).</message>
                    </requireReleaseVersion>
                    <requireReleaseDeps>
                      <message>A release can't depend on snapshots.</message>
                    </requireReleaseDeps>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <configuration>
              <quiet>true</quiet>
              <doclint>all,-missing</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <!-- The passphrase comes from MAVEN_GPG_PASSPHRASE; loopback lets gpg take it without a terminal. -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- Uploads and validates; publishing is a click in the Central Portal, so a bad bundle can still be dropped. -->
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
              <skipPublishing>${central.skipPublishing}</skipPublishing>
              <excludeArtifacts>
                <artifact>pgtasks-benchmark</artifact>
                <artifact>pgtasks-coverage</artifact>
              </excludeArtifacts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!--
      Test coverage with JaCoCo: each module's tests run with the agent, and pgtasks-coverage
      merges them into one report in pgtasks-coverage/target/site/jacoco-aggregate. CI's
      coverage job runs with it. Off by default, so local runs and the Fray and benchmark JVMs
      don't carry the agent.
    -->
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>postgres-17</id>
      <activation>
        <property>
          <name>pgtasks.test.postgres.version</name>
          <value>17</value>
        </property>
      </activation>
      <properties>
        <embedded-postgres-binaries.version>17.12.0</embedded-postgres-binaries.version>
      </properties>
    </profile>
    <profile>
      <id>postgres-18</id>
      <activation>
        <property>
          <name>pgtasks.test.postgres.version</name>
          <value>18</value>
        </property>
      </activation>
      <properties>
        <embedded-postgres-binaries.version>18.7.0</embedded-postgres-binaries.version>
      </properties>
    </profile>
    <profile>
      <id>postgres-19</id>
      <activation>
        <property>
          <name>pgtasks.test.postgres.version</name>
          <value>19</value>
        </property>
      </activation>
      <properties>
        <embedded-postgres-binaries.version>19.0.0</embedded-postgres-binaries.version>
      </properties>
    </profile>
  </profiles>
</project>
