<?xml version="1.0" encoding="UTF-8"?>
<project child.project.url.inherit.append.path="false" xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.khopland.pgtasks</groupId>
  <artifactId>pgtasks-parent</artifactId>
  <name>pgtasks parent</name>
  <version>0.2.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <description>A task queue in the Postgres database you already run.</description>
  <url>https://github.com/khopland/pgtasks</url>
  <inceptionYear>2020</inceptionYear>
  <!-- Maven Central requires name, description, url, licenses, developers and scm in every published pom. -->
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>khopland</id>
      <name>Kristoffer Larsen Hopland</name>
      <url>https://github.com/khopland</url>
    </developer>
  </developers>
  <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/khopland/pgtasks.git</connection>
    <developerConnection>scm:git:git@github.com:khopland/pgtasks.git</developerConnection>
    <url>https://github.com/khopland/pgtasks</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/khopland/pgtasks/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <postgresql.version>42.7.15</postgresql.version>
    <hikari.version>7.1.0</hikari.version>
    <!-- Test scope only: pgtasks depends on no migration tool. For the 1.x schema and the parity test. -->
    <liquibase.version>5.0.4</liquibase.version>
    <flyway.version>13.13.0</flyway.version>
    <embedded-postgres.version>2.2.3</embedded-postgres.version>
    <!-- The default Postgres for tests; CI also runs the profiles below. See README, Requirements. -->
    <embedded-postgres-binaries.version>17.12.0</embedded-postgres-binaries.version>
    <slf4j.version>2.0.20</slf4j.version>
    <micrometer.version>1.18.0</micrometer.version>
    <jspecify.version>1.0.1</jspecify.version>
    <jackson.version>3.3.0</jackson.version>
    <micrometer-tracing.version>1.8.0</micrometer-tracing.version>
    <!-- Compile-time checks on main code; javac needs the exports in .mvn/jvm.config. -->
    <errorprone.version>2.53.0</errorprone.version>
    <nullaway.version>0.14.4</nullaway.version>
    <!-- Release profile: true builds the Central bundle without uploading it, to check it locally. -->
    <central.skipPublishing>false</central.skipPublishing>
    <!--
      API compatibility (japicmp): every jar is compared with the same artifact at this released
      version, and any binary or source incompatible change fails the build. After each release,
      RELEASING.md sets it to that version and clears the accepted breaks in the japicmp plugin
      below. A break made on purpose is added there as an exclude, with a line in CHANGELOG.md,
      so it is a decision and not an accident.
    -->
    <pgtasks.api.baseline>0.1.0</pgtasks.api.baseline>
    <japicmp.skip>false</japicmp.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
