<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Import it to use one version of every pgtasks module. No parent: a BOM manages versions and nothing else. -->
  <groupId>io.github.khopland.pgtasks</groupId>
  <artifactId>pgtasks-bom</artifactId>
  <name>pgtasks BOM</name>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <description>pgtasks bill of materials: import it, then add the modules without versions.</description>
  <url>https://github.com/khopland/pgtasks</url>
  <inceptionYear>2020</inceptionYear>
  <!-- Without a parent, the BOM repeats the metadata Maven Central requires. Keep it in step with pgtasks-parent. -->
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>khopland</id>
      <name>Kristoffer Larsen Hopland</name>
      <url>https://github.com/khopland</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/khopland/pgtasks.git</connection>
    <developerConnection>scm:git:git@github.com:khopland/pgtasks.git</developerConnection>
    <url>https://github.com/khopland/pgtasks</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/khopland/pgtasks/issues</url>
  </issueManagement>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-spi</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-engine</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-postgres</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-memory</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-rate-limit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-rate-limit-postgres</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-micrometer</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-jackson</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-junit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.khopland.pgtasks</groupId>
        <artifactId>pgtasks-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- The release profile of pgtasks-parent, for a pom without code: signatures and the Central Portal bundle. -->
  <profiles>
    <profile>
      <id>release</id>
      <properties>
        <central.skipPublishing>false</central.skipPublishing>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
              <skipPublishing>${central.skipPublishing}</skipPublishing>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
