<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.example.task2</groupId>
    <artifactId>task2-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../task2-parent/pom.xml</relativePath>
  </parent>

  <artifactId>task2-engine</artifactId>
  <description>Task 2.0 engine: workers on virtual threads, fenced completion, retries, expiry, wake-ups and rate admission. Storage-agnostic.</description>

  <dependencies>
    <dependency>
      <groupId>org.example.task2</groupId>
      <artifactId>task2-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.example.task2</groupId>
      <artifactId>task2-spi</artifactId>
    </dependency>

    <dependency>
      <groupId>org.example.task2</groupId>
      <artifactId>task2-memory</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.example.task2</groupId>
      <artifactId>task2-postgres</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.example.task2</groupId>
      <artifactId>task2-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- The vertical slice (org.example.task2.slice) is reused by the Spring Boot starter's tests. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
