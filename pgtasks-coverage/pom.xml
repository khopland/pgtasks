<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.khopland.pgtasks</groupId>
    <artifactId>pgtasks-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <relativePath>../pgtasks-parent/pom.xml</relativePath>
  </parent>

  <!--
    One coverage report for every module, from the JaCoCo data each module's tests leave behind.
    Built only with -Pcoverage (see the root pom); never published.
      mvn verify -Pcoverage
      open pgtasks-coverage/target/site/jacoco-aggregate/index.html
  -->
  <artifactId>pgtasks-coverage</artifactId>
  <name>pgtasks coverage</name>
  <packaging>pom</packaging>
  <description>Aggregated test coverage of the pgtasks modules. Not published.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <dependencies>
    <dependency><groupId>${project.groupId}</groupId><artifactId>pgtasks-api</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>pgtasks-spi</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>pgtasks-test</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>pgtasks-postgres</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>pgtasks-memory</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>pgtasks-engine</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>pgtasks-rate-limit</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>pgtasks-rate-limit-postgres</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>pgtasks-circuit-breaker</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>pgtasks-micrometer</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>pgtasks-jackson</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>pgtasks-junit</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>pgtasks-spring-boot-starter</artifactId><version>${project.version}</version></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>report-aggregate</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
