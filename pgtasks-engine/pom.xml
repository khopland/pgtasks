<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.khopland.pgtasks</groupId>
    <artifactId>pgtasks-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pgtasks-parent/pom.xml</relativePath>
  </parent>

  <artifactId>pgtasks-engine</artifactId>
  <description>pgtasks engine: workers on virtual threads, fenced completion, retries, expiry, wake-ups and rate admission. Storage-agnostic.</description>

  <properties>
    <module.name>io.github.khopland.pgtasks.engine</module.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.khopland.pgtasks</groupId>
      <artifactId>pgtasks-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.khopland.pgtasks</groupId>
      <artifactId>pgtasks-spi</artifactId>
    </dependency>
    <!-- Logging: the application picks the backend. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>io.github.khopland.pgtasks</groupId>
      <artifactId>pgtasks-memory</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.khopland.pgtasks</groupId>
      <artifactId>pgtasks-postgres</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.khopland.pgtasks</groupId>
      <artifactId>pgtasks-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- slf4j-simple's MDC does nothing; the MDC header tests read it back. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>1.5.38</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- The vertical slice (io.github.khopland.pgtasks.slice) is reused by the Spring Boot starter's tests. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
