<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.khopland.pgtasks</groupId>
    <artifactId>pgtasks-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pgtasks-parent/pom.xml</relativePath>
  </parent>

  <artifactId>pgtasks-engine</artifactId>
  <name>pgtasks engine</name>
  <description>pgtasks engine: workers on virtual threads, fenced completion, retries, expiry, wake-ups and extension hooks. Storage-agnostic.</description>

  <properties>
    <module.name>io.github.khopland.pgtasks.engine</module.name>
    <fray.version>0.9.2</fray.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.khopland.pgtasks</groupId>
      <artifactId>pgtasks-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.khopland.pgtasks</groupId>
      <artifactId>pgtasks-spi</artifactId>
    </dependency>
    <!-- Logging: the application picks the backend. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>io.github.khopland.pgtasks</groupId>
      <artifactId>pgtasks-memory</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.khopland.pgtasks</groupId>
      <artifactId>pgtasks-postgres</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.khopland.pgtasks</groupId>
      <artifactId>pgtasks-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The *FrayTest classes; they compile always and run with -Pfray. -->
    <dependency>
      <groupId>org.pastalab.fray</groupId>
      <artifactId>fray-junit</artifactId>
      <version>${fray.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- slf4j-simple's MDC does nothing; the MDC header tests read it back. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>1.5.38</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- ThreadDump, used by the tests, reads the JDK's management MXBeans. -->
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs combine.children="append">
                <arg>--add-modules</arg>
                <arg>jdk.management</arg>
                <arg>--add-reads</arg>
                <arg>${module.name}=java.management,jdk.management</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The vertical slice (io.github.khopland.pgtasks.slice) is reused by the Spring Boot starter's tests. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- The *FrayTest classes explore thread interleavings on Fray's instrumented JDK and run only
           with -Pfray: mvn verify -pl pgtasks-engine -am -Pfray -Dtest='*FrayTest' -Dsurefire.failIfNoSpecifiedTests=false
           A failure leaves a replayable schedule in target/fray/fray-report. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/*FrayTest.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>fray</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pastalab.fray.maven</groupId>
            <artifactId>fray-plugins-maven</artifactId>
            <version>${fray.version}</version>
            <executions>
              <execution>
                <id>prepare-fray</id>
                <goals>
                  <goal>prepare-fray</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration combine.self="override">
              <trimStackTrace>false</trimStackTrace>
              <includes>
                <include>**/*FrayTest.java</include>
              </includes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
